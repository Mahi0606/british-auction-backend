// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SUPPLIER
  ADMIN
}

enum RFQStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum AuctionStatus {
  ACTIVE
  CLOSED
  FORCE_CLOSED
}

enum ExtensionTrigger {
  ANY_BID
  ANY_RANK_CHANGE
  L1_CHANGE
}

enum ActivityType {
  BID_SUBMITTED
  RANK_CHANGED
  L1_CHANGED
  AUCTION_EXTENDED
  AUCTION_CLOSED
  FORCE_CLOSED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(BUYER)
  createdAt    DateTime @default(now())

  supplier     Supplier?
  activityLogs ActivityLog[] @relation("UserActivityLogs")
  rfqs         RFQ[]         @relation("BuyerRFQs")
}

model Supplier {
  id            String   @id @default(uuid())
  userId        String   @unique
  companyName   String
  contactNumber String?
  createdAt     DateTime @default(now())
  bids          Bid[]

  user User @relation(fields: [userId], references: [id])
}

model RFQ {
  id               String    @id @default(uuid())
  referenceId      String    @unique
  name             String
  description      String?
  buyerId          String
  pickupLocation   String
  deliveryLocation String
  serviceDate      DateTime
  status           RFQStatus @default(DRAFT)
  createdAt        DateTime  @default(now())
  autiion          Auction?

  buyer User @relation("BuyerRFQs", fields: [buyerId], references: [id])

  @@index([buyerId])
  @@index([status])
}

model Auction {
  id    String @id @default(uuid())
  rfqId String @unique

  startTime         DateTime
  originalCloseTime DateTime
  currentCloseTime  DateTime
  forcedCloseTime   DateTime

  triggerWindowMinutes     Int
  extensionDurationMinutes Int
  extensionTrigger         ExtensionTrigger

  status    AuctionStatus @default(ACTIVE)
  createdAt DateTime      @default(now())

  bids          Bid[]
  acitivityLogs ActivityLog[]

  rfq RFQ @relation(fields: [rfqId], references: [id])

  @@index([status, currentCloseTime])
}

model Bid {
  id         String @id @default(uuid())
  auctionId  String
  supplierId String

  freightCharges     Decimal @db.Decimal(12, 2)
  originCharges      Decimal @db.Decimal(12, 2)
  destinationCharges Decimal @db.Decimal(12, 2)
  totalAmount        Decimal @db.Decimal(12, 2)

  transitTime String
  validity    DateTime

  createdAt DateTime @default(now())

  auction  Auction  @relation(fields: [auctionId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([auctionId, totalAmount])
  @@index([auctionId, supplierId])
}

model ActivityLog {
  id          String       @id @default(uuid())
  auctionId   String
  actorUserId String?
  eventType   ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())

  auction Auction @relation(fields: [auctionId], references: [id])
  actor   User?   @relation("UserActivityLogs", fields: [actorUserId], references: [id])

  @@index([auctionId, createdAt])
  @@index([actorUserId])
}
